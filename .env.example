# ==============================================================================
# 메리츠증권 Open API 설정
# ==============================================================================
MERITZ_APP_KEY=your_meritz_app_key_here
MERITZ_APP_SECRET=your_meritz_app_secret_here

# 서버 URL (기본값: 운영 서버)
MERITZ_BASE_URL=https://openapi.imeritz.com:9443
MERITZ_WS_URL=wss://openapi.imeritz.com:29443/websocket

# 안전 스위치 (1: 조회 전용 모드, 0: 주문/실행 가능 모드)
# 초기 테스트 시 반드시 1로 설정하여 안전하게 검증하세요.
MERITZ_READ_ONLY=1
MERITZ_TIMEOUT=15

# ==============================================================================
# CA VR 전략 및 시스템 설정 (Kiwoom 이식)
# ==============================================================================
ACCOUNT_NO=
DEFAULT_MARKET=KR  # KR (국내) 또는 US (해외)
TARGET_SYMBOL=005930

# 데이터베이스 및 로그 경로
DB_PATH=data/meritz_trade.db
LOG_LEVEL=INFO
LOG_DIR=logs

# 알림 서비스 (선택 사항)
NOTIFIER_ENABLED=false
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
